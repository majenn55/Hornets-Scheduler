# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hornets_scheduler"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-secret-here"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
EMAIL_FROM="noreply@hornets-scheduler.com"

# File Storage (S3-compatible)
S3_BUCKET="hornets-scheduler-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Live Streaming
STREAM_SERVER_URL="rtmp://localhost:1935/live"
STREAM_HLS_URL="https://stream.hornets-scheduler.com/hls"
